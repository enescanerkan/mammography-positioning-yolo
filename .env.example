# =============================================================================
# Mammography Positioning - Environment Variables
# =============================================================================
# Copy this file to .env and update values for your environment.
# These override the defaults in configs/app_config.yaml.
# =============================================================================

# --- Application ---
APP_ENV=development                     # development | test | preprod | production
APP_NAME=mammography-positioning
APP_VERSION=1.0.0

# --- Paths (inside container: relative to /docker) ---
DATA_ROOT=data
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
LABELS_PATH=data/labels
WEIGHTS_DIR=weights
EXPERIMENTS_DIR=experiments
EVALUATION_DIR=evaluation_results

# --- Logging ---
LOG_LEVEL=INFO

# --- Training ---
TRAINING_DEVICE=0
TRAINING_WORKERS=8
TRAINING_BATCH=16
TRAINING_IMGSZ=640
TRAINING_DEFAULT_CONFIG=configs/wavelet_mlo.yaml

# --- Inference ---
INFERENCE_CONF=0.5
INFERENCE_NMS=0.45
INFERENCE_DEVICE=0

# --- Evaluation ---
EVAL_THRESHOLD_MM=10.0
EVAL_DUAL_THRESHOLDS=false
EVAL_SKIP_VIZ=false

# --- Docker Compose ---
EXPERIMENT_CONFIG=configs/wavelet_mlo.yaml
PIPELINE_MODE=full

# --- CI/CD (Jenkins) ---
MAMMOGRAPHY_IMAGE=mammography-positioning
RELEASE_NUMBER=1.0.0
GIT_COMMIT=
BUILD_NUMBER=
ENVIRONMENT_NAME=test
