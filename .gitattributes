# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Keep Windows batch files with CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.pt   binary
*.pth  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.dcm  binary
*.dicom binary
